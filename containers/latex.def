Bootstrap: docker
From: ubuntu:20.04

# Ubuntu image: Lightest
# Build time 2m
# Size 300M
# home is /root
# software goes to /root

IncludeCmd: yes

%labels
MAINTAINER Aitor Gonzalez
EMAIL aitor.gonzalez@univ-amu.fr

%environment
export LC_ALL=C
export PATH=/opt/texlive/bin/x86_64-linux:$PATH

%post
export DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true
# Change ubuntu repository to closer one
sed -i 's|http://archive.ubuntu.com/ubuntu/|http://ftp.rezopole.net/ubuntu/|g' /etc/apt/sources.list
sed -i 's|http://security.ubuntu.com/ubuntu/|http://ftp.rezopole.net/ubuntu/|g' /etc/apt/sources.list
apt update
apt update --fix-missing
apt -y upgrade

################################################################################
#
# texinfo
#
################################################################################

%post
ln -fs /usr/share/zoneinfo/Europe/Paris /etc/localtime
apt install -y tzdata
dpkg-reconfigure --frontend noninteractive tzdata
apt install -y texinfo

################################################################################
#
# texlive from source to keep updated repository
#
################################################################################

apt install -y wget
wget https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/2024/install-tl-unx.tar.gz
zcat install-tl-unx.tar.gz | tar xf -
cd install-tl-20240312
./install-tl --no-interaction --scheme=small --no-doc-install --no-src-install --texdir=/opt/texlive
cd ..
rm install-tl-unx.tar.gz

/opt/texlive/bin/x86_64-linux/tlmgr install biber
/opt/texlive/bin/x86_64-linux/tlmgr install biblatex
/opt/texlive/bin/x86_64-linux/tlmgr install csvsimple

################################################################################
#
# Clean ubuntu packages
#
################################################################################

%post
apt clean
rm -rf /var/lib/apt/lists/*

